      <tbody>
        <tr><td>Finger grooves</td><td>Yes, molded into frame</td><td>No, flat front strap</td></tr>
        <tr><td>Backstraps</td><td>Fixed grip</td><td>Modular Backstrap System, 4 sizes</td></tr>
        <tr><td>Magazine release</td><td>Right side only, small</td><td>Reversible, enlarged</td></tr>
        <tr><td>Slide stop</td><td>Right side only</td><td>Ambidextrous</td></tr>
        <tr><td>Magwell</td><td>Straight walls</td><td>Slightly flared for reloads</td></tr>
        <tr><td>Barrel</td><td>Polygonal rifling, standard crown</td><td>Glock Marksman Barrel, recessed crown, tighter chamber</td></tr>
        <tr><td>Finish</td><td>Tenifer based</td><td>nDLC, harder and more corrosion resistant</td></tr>
