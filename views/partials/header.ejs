<div class="utility">
  <div class="wrap">
    <div>
      <% if (hasRealPhone) { %>
        Sales: <a href="tel:<%= business.contact.phone.replace(/[^\d+]/g, '') %>"><%= business.contact.phone %></a>
      <% } else { %>
        Licensed dealer. <a href="/contact">Message the shop</a>.
      <% } %>
    </div>
    <nav class="utility-legal" aria-label="Compliance">
      <a href="/compliance">Compliance</a>
      <a href="/shipping-and-transfer-policy">Shipping and transfers</a>
      <a href="/contact">Contact</a>
    </nav>
  </div>
</div>

<header class="masthead">
  <div class="wrap">
    <a class="brand" href="/">
      <svg width="38" height="38" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
        <rect width="64" height="64" rx="6" fill="#14171a"></rect>
        <circle cx="32" cy="32" r="19" fill="none" stroke="#ffffff" stroke-width="3"></circle>
        <circle cx="32" cy="32" r="8.5" fill="#8c2f14"></circle>
        <g stroke="#ffffff" stroke-width="3">
          <path d="M32 13v7"></path><path d="M32 44v7"></path><path d="M13 32h7"></path><path d="M44 32h7"></path>
          <path d="M18.6 18.6l4.9 4.9"></path><path d="M40.5 40.5l4.9 4.9"></path>
          <path d="M45.4 18.6l-4.9 4.9"></path><path d="M23.5 40.5l-4.9 4.9"></path>
        </g>
      </svg>
      <span>
        <span class="brand-name"><%= brand %></span>
        <span class="brand-sub">Glock pistols, slides and triggers</span>
      </span>
    </a>

    <form class="searchbar" action="/search" method="get" role="search">
      <label for="site-search">Search the catalogue</label>
      <input type="search" id="site-search" name="q" placeholder="Model, caliber or SKU" maxlength="60"
             autocomplete="off" value="<%= typeof searchTerm !== 'undefined' ? searchTerm : '' %>">
      <button type="submit">Search catalogue</button>
    </form>

    <div class="header-actions">
      <button type="button" class="nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="primary-nav">Menu</button>
      <a class="btn btn-secondary btn-sm" href="/cart">
        Cart<% if (cartCount > 0) { %><span class="cart-count"><%= cartCount %></span><% } %>
      </a>
    </div>
  </div>
</header>

<nav class="mainnav" id="mainnav" aria-label="Primary">
  <div class="wrap">
    <ul id="primary-nav">
      <li><a href="/glock-pistols-for-sale"<%= currentPath === '/glock-pistols-for-sale' ? ' aria-current="page"' : '' %>>All pistols</a></li>
      <li><a href="/collections/glock-factory-handguns"<%= currentPath === '/collections/glock-factory-handguns' ? ' aria-current="page"' : '' %>>Factory</a></li>
      <li><a href="/collections/glock-factory-colored-handguns"<%= currentPath === '/collections/glock-factory-colored-handguns' ? ' aria-current="page"' : '' %>>Colored</a></li>
      <li><a href="/collections/custom-glocks"<%= currentPath === '/collections/custom-glocks' ? ' aria-current="page"' : '' %>>Custom builds</a></li>
      <li><a href="/collections/optic-ready-glocks"<%= currentPath === '/collections/optic-ready-glocks' ? ' aria-current="page"' : '' %>>Optic ready</a></li>
      <li><a href="/collections/gen-6-glocks"<%= currentPath === '/collections/gen-6-glocks' ? ' aria-current="page"' : '' %>>Gen 6</a></li>
      <li><a href="/collections/glock-slides"<%= currentPath === '/collections/glock-slides' ? ' aria-current="page"' : '' %>>Slides</a></li>
      <li><a href="/collections/glock-triggers"<%= currentPath === '/collections/glock-triggers' ? ' aria-current="page"' : '' %>>Triggers</a></li>
      <li><a href="/models"<%= currentPath === '/models' ? ' aria-current="page"' : '' %>>Browse by model</a></li>
      <li><a href="/guides"<%= currentPath && currentPath.startsWith('/guides') ? ' aria-current="page"' : '' %>>Guides</a></li>
      <li><a href="/about"<%= currentPath === '/about' ? ' aria-current="page"' : '' %>>About Us</a></li>
    </ul>
  </div>
</nav>

<div class="agegate" id="agegate" hidden role="dialog" aria-modal="true" aria-labelledby="agegate-title">
  <div class="agegate-backdrop" id="agegate-backdrop"></div>
  <div class="agegate-box" role="document">
    <button type="button" class="agegate-close" id="agegate-close" aria-label="Close age verification">×</button>
    <h2 id="agegate-title">Are you 21 or older?</h2>
    <p id="agegate-text">
      This site lists firearms and firearm parts. You must be 21 or older to purchase a handgun from a licensed dealer in the United States, and 18 or older for rifles, shotguns and parts. Texas has no additional permit, but federal law still applies.
    </p>
    <div class="agegate-actions">
      <button type="button" class="btn btn-primary" id="agegate-yes">I am 21 or older</button>
      <button type="button" class="btn btn-secondary" id="agegate-no">I am under 21</button>
    </div>
    <p class="small">If you are under 21 you can still browse slides, triggers and compliance information. Handgun purchases require 21 plus. See the <a href="/compliance">compliance notice</a> for full rules.</p>
    <div id="agegate-under" hidden>
      <div class="note note-legal agegate-under-note">
        <h3>Under 21</h3>
        <p>You must be 21 or older to buy a handgun from a dealer. You must be 18 or older for long guns and parts. You can continue browsing, but you will not be able to submit a handgun order request.</p>
        <p><a href="/compliance">Read compliance rules</a> · <a href="/collections/glock-slides">Browse slides</a> · <a href="/collections/glock-triggers">Browse triggers</a></p>
      </div>
    </div>
  </div>
</div>
