<%- include('partials/head') %>

<div class="pagehead">
  <div class="wrap">
    <h1>Order request</h1>
    <p>
      This form sends your list to the shop so a member of staff can confirm availability, check
      eligibility and quote the transfer. It takes no payment.
    </p>
  </div>
</div>

<div class="section">
  <div class="wrap">
    <div class="grid grid-2">
      <div>
        <% if (errors.length) { %>
          <div class="form-errors" role="alert" tabindex="-1" id="form-errors">
            <h2>Your request was not sent</h2>
            <ul>
              <% errors.forEach(function (e) { %><li><a href="#<%= e.field %>"><%= e.message %></a></li><% }); %>
            </ul>
          </div>
        <% } %>

        <form class="formcard" action="/order-request" method="post" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div class="hp" aria-hidden="true">
            <label for="company_website">Leave this field empty</label>
            <input type="text" id="company_website" name="company_website" tabindex="-1" autocomplete="off">
          </div>

          <div class="formgrid">
            <fieldset>
              <legend>How the shop should reach you</legend>
              <div class="formgrid formgrid-2">
                <div class="field">
                  <label for="name">Full name (required)</label>
                  <input type="text" id="name" name="name" required maxlength="80" autocomplete="name"
                         value="<%= values.name || '' %>" <%= fieldErrors.name ? 'aria-invalid="true" aria-describedby="err-name"' : '' %>>
                  <% if (fieldErrors.name) { %><span class="field-error" id="err-name"><%= fieldErrors.name %></span><% } %>
                </div>
                <div class="field">
                  <label for="email">Email address (required)</label>
                  <input type="email" id="email" name="email" required maxlength="254" autocomplete="email"
                         inputmode="email" value="<%= values.email || '' %>"
                         <%= fieldErrors.email ? 'aria-invalid="true" aria-describedby="err-email"' : '' %>>
                  <% if (fieldErrors.email) { %><span class="field-error" id="err-email"><%= fieldErrors.email %></span><% } %>
                </div>
              </div>
              <div class="field">
                <label for="phone">Phone number (optional)</label>
                <input type="tel" id="phone" name="phone" maxlength="32" autocomplete="tel"
                       value="<%= values.phone || '' %>" aria-describedby="phone-hint">
                <span class="hint" id="phone-hint">Only give a number if you would rather be called than emailed.</span>
              </div>
            </fieldset>

            <fieldset>
              <legend>Your request</legend>
              <div class="field">
                <label for="message">Notes for the shop (optional)</label>
                <textarea id="message" name="message" rows="5" maxlength="1500" aria-describedby="message-hint"><%= values.message || '' %></textarea>
                <span class="hint" id="message-hint">
                  Useful details: the licensed dealer you want the transfer routed to, a delivery timeframe,
                  or a question about condition. Do not send identity documents or licence numbers through
                  this form.
                </span>
              </div>
              <p class="meta-updated">
                Items attached to this request: <%= itemCount %>. <a href="/cart">Review the list</a>.
              </p>
            </fieldset>

            <fieldset>
              <legend>Confirmations</legend>
              <div class="check">
                <input type="checkbox" id="attest" name="attest" value="yes"
                       <%= values.attest ? 'checked' : '' %>
                       <%= fieldErrors.attest ? 'aria-invalid="true" aria-describedby="err-attest"' : '' %>>
                <label for="attest">
                  I confirm I am at least <%= minAge %> years old and that I am not prohibited from
                  buying or possessing a firearm where I live. (required)
                  <% if (fieldErrors.attest) { %><span class="field-error" id="err-attest"><%= fieldErrors.attest %></span><% } %>
                </label>
              </div>
              <div class="check">
                <input type="checkbox" id="consent" name="consent" value="yes"
                       <%= values.consent ? 'checked' : '' %>
                       <%= fieldErrors.consent ? 'aria-invalid="true" aria-describedby="err-consent"' : '' %>>
                <label for="consent">
                  I agree that the shop may store my name, email and message to answer this request, as
                  described in the <a href="/privacy-policy">privacy policy</a>. (required)
                  <% if (fieldErrors.consent) { %><span class="field-error" id="err-consent"><%= fieldErrors.consent %></span><% } %>
                </label>
              </div>
              <div class="check">
                <input type="checkbox" id="marketing" name="marketing" value="yes" <%= values.marketing ? 'checked' : '' %>>
                <label for="marketing">
                  Send me occasional stock updates by email. Optional, and you can stop at any time.
                </label>
              </div>
            </fieldset>

            <p><button type="submit" class="btn btn-primary">Send my order request to the shop</button></p>
          </div>
        </form>
      </div>

      <div class="stack">
        <div class="note note-legal">
          <h3>What happens next</h3>
          <p>
            A member of staff reads the request, confirms whether the items are still available, and
            replies with the transfer route and the full cost. No card details are taken on this site.
          </p>
        </div>
        <div class="note">
          <h3>What is stored</h3>
          <p>
            Your name, email address, optional phone number, your message and the list of items. Nothing
            else. It is kept for <%= retentionMonths %> months and then deleted automatically.
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
