<%- include('partials/head') %>

<div class="pagehead">
  <div class="wrap">
    <h1>Checkout</h1>
    <p>
      Complete your order. Secure payment is processed here and firearms ship to your dropoff location where the licensed dealer completes the transfer.
    </p>
  </div>
</div>

<div class="section">
  <div class="wrap">
    <div class="grid grid-2">
      <div>
        <% if (errors.length) { %>
          <div class="form-errors" role="alert" tabindex="-1" id="form-errors">
            <h2>Your request was not sent</h2>
            <ul>
              <% errors.forEach(function (e) { %><li><a href="#<%= e.field %>"><%= e.message %></a></li><% }); %>
            </ul>
          </div>
        <% } %>

        <form class="formcard" action="/order-request" method="post" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div class="hp" aria-hidden="true">
            <label for="company_website">Leave this field empty</label>
            <input type="text" id="company_website" name="company_website" tabindex="-1" autocomplete="off">
          </div>

          <div class="formgrid">
            <fieldset>
              <legend>How the shop should reach you</legend>
              <div class="formgrid formgrid-2">
                <div class="field">
                  <label for="name">Full name (required)</label>
                  <input type="text" id="name" name="name" required maxlength="80" autocomplete="name"
                         value="<%= values.name || '' %>" <%= fieldErrors.name ? 'aria-invalid="true" aria-describedby="err-name"' : '' %>>
                  <% if (fieldErrors.name) { %><span class="field-error" id="err-name"><%= fieldErrors.name %></span><% } %>
                </div>
                <div class="field">
                  <label for="email">Email address (required)</label>
                  <input type="email" id="email" name="email" required maxlength="254" autocomplete="email"
                         inputmode="email" value="<%= values.email || '' %>"
                         <%= fieldErrors.email ? 'aria-invalid="true" aria-describedby="err-email"' : '' %>>
                  <% if (fieldErrors.email) { %><span class="field-error" id="err-email"><%= fieldErrors.email %></span><% } %>
                </div>
              </div>
              <div class="field">
                <label for="phone">Phone number (optional)</label>
                <input type="tel" id="phone" name="phone" maxlength="32" autocomplete="tel"
                       value="<%= values.phone || '' %>" aria-describedby="phone-hint">
                <span class="hint" id="phone-hint">Only give a number if you would rather be called than emailed.</span>
              </div>
            </fieldset>

            <fieldset>
              <legend>Your request</legend>
              <div class="field">
                <label for="message">Notes for the shop (optional)</label>
                <textarea id="message" name="message" rows="5" maxlength="1500" aria-describedby="message-hint"><%= values.message || '' %></textarea>
                <span class="hint" id="message-hint">
                  Useful details: the licensed dealer you want the transfer routed to, a delivery timeframe,
                  or a question about condition. Do not send identity documents or licence numbers through
                  this form.
                </span>
              </div>
              <p class="meta-updated">
                Items attached to this request: <%= itemCount %>. <a href="/cart">Review the list</a>.
              </p>
            </fieldset>

            <fieldset>
              <legend>Payment method (required)</legend>
              <p class="hint no-top">Choose how you want to pay. Crypto payments receive 15 percent off the order total.</p>
              <% if (fieldErrors.paymentMethod) { %><span class="field-error" id="err-payment"><%= fieldErrors.paymentMethod %></span><% } %>
              <div class="payment-methods">
                <label class="payment-option<%= values.paymentMethod === 'paypal' ? ' selected' : '' %>">
                  <input type="radio" name="paymentMethod" value="paypal" <%= values.paymentMethod === 'paypal' ? 'checked' : '' %> required>
                  <img src="/img/payments/paypal.svg" alt="PayPal" width="48" height="32" loading="lazy">
                  <span class="payment-name">PayPal</span>
                </label>
                <label class="payment-option<%= values.paymentMethod === 'chime' ? ' selected' : '' %>">
                  <input type="radio" name="paymentMethod" value="chime" <%= values.paymentMethod === 'chime' ? 'checked' : '' %>>
                  <img src="/img/payments/chime.svg" alt="Chime" width="48" height="32" loading="lazy">
                  <span class="payment-name">Chime</span>
                </label>
                <label class="payment-option<%= values.paymentMethod === 'cashapp' ? ' selected' : '' %>">
                  <input type="radio" name="paymentMethod" value="cashapp" <%= values.paymentMethod === 'cashapp' ? 'checked' : '' %>>
                  <img src="/img/payments/cashapp.svg" alt="Cash App" width="48" height="32" loading="lazy">
                  <span class="payment-name">Cash App</span>
                </label>
                <label class="payment-option<%= values.paymentMethod === 'applepay' ? ' selected' : '' %>">
                  <input type="radio" name="paymentMethod" value="applepay" <%= values.paymentMethod === 'applepay' ? 'checked' : '' %>>
                  <img src="/img/payments/applepay.svg" alt="Apple Pay" width="48" height="32" loading="lazy">
                  <span class="payment-name">Apple Pay</span>
                </label>
                <label class="payment-option payment-crypto<%= values.paymentMethod === 'crypto' ? ' selected' : '' %>">
                  <input type="radio" name="paymentMethod" value="crypto" <%= values.paymentMethod === 'crypto' ? 'checked' : '' %>>
                  <img src="/img/payments/crypto.svg" alt="Crypto" width="48" height="32" loading="lazy">
                  <span class="payment-name">Crypto <span class="badge badge-discount">-15%</span></span>
                  <span class="hint">Bitcoin, Ethereum and others, 15 percent off</span>
                </label>
              </div>
            </fieldset>

            <fieldset>
              <legend>Confirmations</legend>
              <div class="check">
                <input type="checkbox" id="attest" name="attest" value="yes"
                       <%= values.attest ? 'checked' : '' %>
                       <%= fieldErrors.attest ? 'aria-invalid="true" aria-describedby="err-attest"' : '' %>>
                <label for="attest">
                  I confirm I am at least <%= minAge %> years old and that I am not prohibited from
                  buying or possessing a firearm where I live. (required)
                  <% if (fieldErrors.attest) { %><span class="field-error" id="err-attest"><%= fieldErrors.attest %></span><% } %>
                </label>
              </div>
              <div class="check">
                <input type="checkbox" id="consent" name="consent" value="yes"
                       <%= values.consent ? 'checked' : '' %>
                       <%= fieldErrors.consent ? 'aria-invalid="true" aria-describedby="err-consent"' : '' %>>
                <label for="consent">
                  I agree that the shop may store my name, email and message to answer this request, as
                  described in the <a href="/privacy-policy">privacy policy</a>. (required)
                  <% if (fieldErrors.consent) { %><span class="field-error" id="err-consent"><%= fieldErrors.consent %></span><% } %>
                </label>
              </div>
              <div class="check">
                <input type="checkbox" id="marketing" name="marketing" value="yes" <%= values.marketing ? 'checked' : '' %>>
                <label for="marketing">
                  Send me occasional stock updates by email. Optional, and you can stop at any time.
                </label>
              </div>
            </fieldset>

            <p><button type="submit" class="btn btn-primary">Place order and pay securely</button></p>
          </div>
        </form>
      </div>

      <div class="stack">
        <div class="note note-legal">
          <h3>What happens next</h3>
          <p>
            Your payment is processed securely. The shop confirms availability and ships your items to your dropoff location.
          </p>
        </div>
        <div class="note">
          <h3>Payment options</h3>
          <ul>
            <li><strong>PayPal</strong>, secure checkout via PayPal balance or linked card.</li>
            <li><strong>Chime</strong>, pay from your Chime account.</li>
            <li><strong>Cash App</strong>, instant transfer via Cash App.</li>
            <li><strong>Apple Pay</strong>, fast checkout on iPhone and Mac.</li>
            <li><strong>Crypto</strong>, Bitcoin, Ethereum and others. <strong>15 percent off</strong> the order total when you pay with crypto.</li>
          </ul>
        </div>
        <div class="note">
          <h3>What is stored</h3>
          <p>
            Your name, email address, optional phone number, your message, chosen payment method and the list of items. Nothing
            else. It is kept for <%= retentionMonths %> months and then deleted automatically.
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
