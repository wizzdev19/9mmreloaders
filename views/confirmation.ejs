<%- include('partials/head') %>

<div class="pagehead">
  <div class="wrap">
    <h1><%= heading %></h1>
  </div>
</div>

<div class="section">
  <div class="wrap">
    <div class="formcard">
      <div class="form-ok" role="status">
        <h2><%= confirmTitle %></h2>
        <p><%= confirmBody %></p>
        <% if (reference) { %><p>Your reference is <strong><%= reference %></strong>. Quote it if you follow up.</p><% } %>
      </div>
      <p class="stack">
        <a class="btn btn-secondary" href="/glock-pistols-for-sale">Back to the catalogue</a>
      </p>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
