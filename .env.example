# Copy to .env and fill in. NEVER commit .env.
# Every value here is read server side only. Nothing in this file is sent to the browser.

# ---- Runtime ----
NODE_ENV=development
PORT=8080
# Public origin of the live site. Used for canonical URLs, sitemap and CORS.
SITE_ORIGIN=http://localhost:8080
# Set to 1 only when running behind a reverse proxy / load balancer you control.
TRUST_PROXY=0
# Verbose errors and stack traces. MUST be 0 in production.
DEBUG_MODE=0

# ---- Session / CSRF signing ----
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_me_with_64_hex_chars

# ---- Database ----
DB_PATH=./data/catalog.db
# Open the catalog read only in production. The web process never needs write access to the catalog.
DB_READONLY=1

# ---- CORS ----
# Comma separated allowlist. Leave empty for same origin only (recommended).
CORS_ALLOWED_ORIGINS=

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
FORM_RATE_LIMIT_MAX=5

# ---- Optional third party keys (leave blank until the client supplies them) ----
# These are loaded server side. Do not add any key here that must reach the browser
# without first confirming it is a publishable key.
ANALYTICS_MEASUREMENT_ID=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
INQUIRY_NOTIFY_EMAIL=
