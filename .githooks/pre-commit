#!/bin/sh
# Refuse a commit that would add a secret or an ignored data file.
# Enable with: git config core.hooksPath .githooks
set -e
if git diff --cached --name-only | grep -qE '^\.env$|\.pem$|\.key$|\.p12$|\.pfx$'; then
  echo "pre-commit: refusing to commit a credential file." >&2
  exit 1
fi
node scripts/scan-secrets.js
