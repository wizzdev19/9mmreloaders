{
  "name": "glock-retail-storefront",
  "version": "1.0.0",
  "private": true,
  "description": "Server rendered catalogue and order request site for a licensed Glock dealer",
  "main": "server.js",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "NODE_ENV=development node server.js",
    "ingest": "node scripts/ingest.js",
    "ingest:nodl": "SKIP_IMAGES=1 node scripts/ingest.js",
    "audit:secrets": "node scripts/scan-secrets.js",
    "audit:claims": "node scripts/check-claims.js",
    "audit:seo": "node scripts/check-seo.js",
    "audit:deps": "npm audit --audit-level=moderate",
    "audit:all": "npm run audit:deps && npm run audit:secrets && npm run audit:claims && npm run audit:seo && npm run audit:cannibal && npm run audit:assets",
    "audit:cannibal": "node scripts/check-cannibalisation.js",
    "audit:assets": "node scripts/check-assets.js",
    "images": "node scripts/make-image-variants.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.4"
  }
}
